<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>$(PluginName)</AssemblyName><Version>0.2.1</Version>
    <Version Condition="'$(PluginName)' == 'CuRussian'">0.2.6</Version>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Casualties Unknown</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(PluginName).cs" />
    <Compile Include="RussianFontFix.cs" Condition="'$(PluginName)' == 'CuRussian'" />
    <Compile Include="RussianNetworkText.cs" Condition="'$(PluginName)' == 'CuRussian'" />
    <Reference Include="$(GameDir)\CasualtiesUnknown_Data\Managed\UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\CasualtiesUnknown_Data\Managed\Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\CasualtiesUnknown_Data\Managed\Newtonsoft.Json.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\CasualtiesUnknown_Data\Managed\Unity.TextMeshPro.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
